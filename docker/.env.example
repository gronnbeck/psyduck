# Copy to docker/.env (which git ignores) and fill in. These reach the
# container as environment variables and are never baked into the image.

# Claude: run `claude setup-token` on a machine with a browser, paste the token.
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub: a token that can read and push your repos and open pull requests.
# `gh auth token` prints the one your own gh login uses.
GH_TOKEN=

# Who the agent's commits are from.
GIT_USER_NAME=
GIT_USER_EMAIL=
